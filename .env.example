# Target page to monitor
TARGET_URL=https://example.com/enrollment

# ntfy topic used for push notifications
NTFY_TOPIC=your-ntfy-topic-here

# Page text that means enrollment is still closed
CLOSED_MARKER=enrollment is not active

# Enrollment check interval, in seconds
CHECK_INTERVAL=90

# Authenticated session heartbeat interval, in seconds
HEARTBEAT_INTERVAL=45

# Optional persistent browser profile directory
# PROFILE_DIR=./browser_profile
